{
  "manifest_version": 3,
  "name": "Pinterest Dynamic New Tab",
  "version": "1.2.0",
  "description": "Transform your new tab into an aesthetic, dynamic Pinterest wallpaper showcase with editable shortcuts, multi-source wallpaper engine, and sleek glassmorphism.",
  "permissions": [
    "topSites",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://pinterest.com/*",
    "https://*.pinimg.com/*",
    "https://pinimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
